# Vorlage für .env — diese Datei gehört ins Git, .env selbst NICHT.
# Kopieren mit:  cp .env.example .env  und dann die Werte einsetzen.

# Proxmox-Zugang für die HOMELAB-Pane.
# Token anlegen: Datacenter → Permissions → API Tokens, Privilege Separation an,
# danach Rolle PVEAuditor auf Pfad / für Benutzer und Token vergeben.
PVE_TOKEN_SECRET=
PVE_URL=
PVE_TOKEN_ID=

# CA des Proxmox-Hosts, zu holen von /etc/pve/pve-root-ca.pem
PVE_CA_PATH=

# Server
PORT=7777
DASHBOARD_CONFIG=./config.json
# Persistente 24-Stunden-Historie des Uptime-Monitors.
DASHBOARD_UPTIME=./uptime.json
# Dauerhaftes Root für lokale /static/*.ics-Dateien (liegt nicht unter dist/).
DASHBOARD_STATIC=./static

# Geräte, die die Config per PUT ändern dürfen (kommagetrennt). GET bleibt offen.
DASHBOARD_WRITE_ALLOW=127.0.0.1
# Erlaubte Hostnamen für Browser-Schreibzugriffe.
DASHBOARD_WRITE_HOSTS=start.home.arpa,10.0.10.20,localhost,127.0.0.1
