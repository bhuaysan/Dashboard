{
  "$schema": "https://opencode.ai/config.json",
  "model": "moonshot/kimi-k3",
  "provider": {
    "moonshot": {
      "options": {
        "baseURL": "https://api.moonshot.ai/v1"
      },
      "models": {
        "kimi-k3": { "name": "Kimi K3" }
      }
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "ssh *": "ask",
      "scp *": "ask",
      "rsync *": "ask",
      "systemctl *": "ask",
      "git push*": "ask"
    },
    "read": {
      "*": "allow",
      ".env": "deny"
    },
    "edit": {
      "*": "allow",
      ".env": "deny",
      "mockup/*": "deny",
      "AGENTS.md": "ask",
      "PLAN.md": "ask"
    },
    "webfetch": "ask"
  }
}
